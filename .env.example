# Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=

# Your Discord server ID. Recommended so slash commands appear immediately.
DISCORD_GUILD_ID=

# Virtual National Guard phpVMS
PHPVMS_BASE_URL=https://virtualnationalguard.com
PHPVMS_API_KEY=

# Optional
CACHE_TTL_SECONDS=300
BACKGROUND_REFRESH_SECONDS=60

# Optional persistent last-known-good cache. Attach a Railway volume at /app/data.
STATE_FILE_PATH=/app/data/fleetbot-state.json

LOG_LEVEL=INFO
